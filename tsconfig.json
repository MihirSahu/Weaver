{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["chrome", "node", "vitest/globals"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["extension/src/**/*.ts", "extension/tests/**/*.ts", "scripts/**/*.mjs", "vitest.config.ts"]
}
